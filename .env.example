# ============================================================================
# Logu AI CFO - environment template
#
# Copy to .env and replace every value marked REQUIRED. Never commit .env.
#   REQUIRED  : must be set (compose or the backend refuses to start / sign in)
#   optional  : has a safe default; uncomment to change
#   DEV ONLY  : only acceptable with ENVIRONMENT=development
#
# Placeholders beginning with CHANGE-ME are rejected at startup when
# ENVIRONMENT is staging or production.
#
# Secret generation (hex keeps values safe to embed in a URL):
#   openssl rand -hex 32
# Fernet key for DATA_ENCRYPTION_KEY (must be a real Fernet key, not hex):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ============================================================================

# --- runtime -----------------------------------------------------------------
ENVIRONMENT=development            # REQUIRED: development | test | staging | production
LOG_LEVEL=INFO                     # optional

# --- database (PostgreSQL 16 only) -------------------------------------------
# REQUIRED. Compose builds the in-network URL from POSTGRES_PASSWORD and overrides
# DATABASE_URL for the backend and migrate services. Set both to the same password.
POSTGRES_PASSWORD=CHANGE-ME-DB-PASSWORD
# Used when running the backend outside compose (host machine). Host must be reachable.
DATABASE_URL=postgresql+psycopg://logu:CHANGE-ME-DB-PASSWORD@localhost:5432/logu_cfo

# --- public edge (Caddy) -------------------------------------------------------
# Local/testing: http://localhost (plain HTTP, no certificate).
# Production: https://your-hostname (for example https://cfo.example.com). Caddy obtains
# the certificate; ports 80 and 443 must be reachable from the internet for this.
SITE_ADDRESS=http://localhost      # REQUIRED
# Host headers the API will accept. Production: only the public hostname(s), no localhost.
TRUSTED_HOSTS=localhost,127.0.0.1  # REQUIRED in staging/production
# Browser origins allowed for CORS and the CSRF Origin check. Development/test: empty = same-origin only.
# Staging/production: REQUIRED (startup fails if empty); exact https:// origins only, e.g. https://cfo.example.com
FRONTEND_ORIGINS=                  # REQUIRED in staging/production
# Reject plain-HTTP requests (JSON 400, never a redirect). Must be true in production.
FORCE_HTTPS=false                  # true in staging/production
# Mark session cookies Secure. Must be true in production (browsers require HTTPS for it).
COOKIE_SECURE=false                # true in staging/production
# Host interface Caddy publishes on. Keep 127.0.0.1 unless you deliberately expose it.
EDGE_BIND_ADDRESS=127.0.0.1        # optional
# Trusted reverse-proxy networks. Only these peers may supply X-Forwarded-For/Proto.
# Compose sets this to Caddy's fixed address. Leave empty when not behind a proxy.
TRUSTED_PROXY_NETWORKS=172.28.10.10/32   # optional (compose already sets it)
# Internal service names allowed in the Host header for direct private-network calls (the frontend's
# server-side requests). Single-label names only. Accepted only when NOT routed through the proxy.
# Compose sets this to "backend". Leave empty outside compose.
INTERNAL_API_HOSTS=                      # optional (compose sets backend)

# --- secrets -------------------------------------------------------------------
# REQUIRED in staging/production. At least 32 characters. Keys the HMAC used for
# password-reset tokens, session token hashes and IP digests. Rotating it invalidates them.
SECURITY_HMAC_KEY=CHANGE-ME-replace-with-output-of-openssl-rand-hex-32   # REQUIRED (replace; min 32 chars)
# REQUIRED in staging/production. Fernet key that encrypts document blobs and sensitive
# fields at rest. Losing it makes stored documents unrecoverable. Back it up securely.
DATA_ENCRYPTION_KEY=                  # REQUIRED (Fernet key, see above)

# --- owner bootstrap (one-time) -----------------------------------------------
# Enable, create the owner account, then set ENABLE_BOOTSTRAP=false and restart.
# Refused in staging/production. Token must be at least 32 characters.
ENABLE_BOOTSTRAP=false             # optional
BOOTSTRAP_TOKEN=                   # required only while ENABLE_BOOTSTRAP=true

# --- sessions and cookies -------------------------------------------------------
SESSION_TTL_MINUTES=480            # optional: absolute session lifetime (15 to 43200)
SESSION_IDLE_MINUTES=60            # optional: idle timeout (5 to 10080)
COOKIE_SAMESITE=lax                # optional: lax | strict

# --- sign-in and reset throttling (sliding window, no permanent lockout) ------
THROTTLE_WINDOW_MINUTES=15         # optional
LOGIN_IP_EMAIL_LIMIT=5             # optional: attempts per IP and e-mail per window
LOGIN_EMAIL_LIMIT=30               # optional: attempts per e-mail per window
LOGIN_IP_LIMIT=100                 # optional: attempts per IP per window
PASSWORD_RESET_TTL_MINUTES=30      # optional: reset token lifetime (5 to 240)

# --- documents and malware scanning ---------------------------------------------
MAX_UPLOAD_BYTES=26214400          # optional: 25 MiB. The Caddy body limit is 30 MB; keep this below it.
STALE_SCAN_MINUTES=15              # optional: scans older than this are reconciled to FAILED
UPLOAD_STORAGE_PATH=/var/lib/logu-ai-cfo/uploads   # optional; compose mounts a volume here
CLAMAV_HOST=clamav                 # optional: clamd host (compose service name)
CLAMAV_PORT=3310                   # optional
CLAMAV_TIMEOUT_SECONDS=60          # optional

# --- providers ------------------------------------------------------------------
# Only "disabled" is valid in Phase 1. Any other value fails validation.
AI_PROVIDER=disabled               # REQUIRED value: disabled
NOTIFICATION_PROVIDER=disabled     # REQUIRED value: disabled

# --- frontend (server-side only) -----------------------------------------------
# Set by compose: API_INTERNAL_URL=http://backend:8000. Server-side variable only.
# Never create NEXT_PUBLIC_* variables for secrets; they are embedded in the browser bundle.
